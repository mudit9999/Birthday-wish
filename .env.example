# Supabase Postgres connection string (transaction pooler, port 6543)
DATABASE_URL=

# API key for Google Gemini (@google/genai)
GEMINI_API_KEY=

# Gemini model name, defaults to gemini-3.5-flash-lite if unset
GEMINI_MODEL=

# Admin's WhatsApp phone number, international digits without +
ADMIN_PHONE=

# Admin login password, must be at least 16 characters
ADMIN_PASSWORD=

# Secret used to sign/derive session tokens, must be at least 32 characters
SESSION_SECRET=

# Directory where database backups are written
BACKUP_DIR=

# Logging verbosity for the worker's pino logger
LOG_LEVEL=
