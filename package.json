{
  "name": "family-wishes",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "tsx --env-file-if-exists=.env packages/db/src/migrate.ts",
    "worker:dev": "tsx --env-file=.env apps/worker/src/main.ts"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
